{
    "name": "360fusion/launchpad",
    "description": "Accounts, workspaces, Stripe billing, admin and a default website for new Laravel builds.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "filament/filament": "^5",
        "firebase/php-jwt": "^7.2",
        "illuminate/support": "^13.0",
        "laravel/cashier": "^16.9",
        "laravel/mcp": "^1.1",
        "laravel/pennant": "^1.26",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "league/commonmark": "^2.10",
        "pragmarx/google2fa": "^9.1",
        "spatie/laravel-passkeys": "^1.8",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/pint": "^1.27",
        "laravel/pulse": "^1.8",
        "laravel/telescope": "^5.27",
        "onelogin/php-saml": "^4.3.2",
        "orchestra/testbench": "*",
        "phpunit/phpunit": "*"
    },
    "suggest": {
        "laravel/telescope": "Debugging on dev and staging; linked from the admin's System group for staff with view-logs",
        "laravel/pulse": "Live monitoring; linked from the admin's System group for staff with view-logs",
        "onelogin/php-saml": "SAML 2.0 single sign-on for teams whose provider does not do OpenID Connect (^4.3.2: earlier releases have the signature-wrapping flaw CVE-2025-66475)"
    },
    "autoload": {
        "psr-4": { "Launchpad\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Launchpad\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Launchpad\\LaunchpadServiceProvider"] }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
